generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lab {
  id            Int            @id @default(autoincrement())
  labName       String
  labAddress    String
  contactPerson String?
  primaryPhone  String
  email         String?
  logo          String?
  status        String         @default("Active")
  createdAt     DateTime       @default(now())
  bills         Bill[]
  expenses      Expense[]
  serviceGroups ServiceGroup[]
  tests         TestMaster[]
  users         User[]
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String
  displayName  String
  role         String
  status       String     @default("Active")
  labId        Int
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
  bills        Bill[]
  payments     Payment[]  @relation("ReceivedBy")
  lab          Lab        @relation(fields: [labId], references: [id])
}

model Patient {
  id                Int      @id @default(autoincrement())
  umr               String   @unique @default(cuid())
  name              String
  age               Int?
  gender            String   @default("M")
  phone             String?
  source            String?
  externalId        String?
  email             String?
  photoUrl          String?
  additionalDetails Json?
  createdAt         DateTime @default(now())
  bills             Bill[]
}

model Doctor {
  id             Int      @id @default(autoincrement())
  name           String
  type           String?  @default("Referral")
  percentage     Float?
  address        String?
  phone          String?
  email          String?
  department     String?
  specialization String?
  location       String?
  hospital       String?
  salesExecutive String?
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  bills          Bill[]
}

model Bill {
  id             Int         @id @default(autoincrement())
  billNumber     Int         @unique
  billDate       DateTime    @default(now())
  patientId      Int
  doctorId       Int?
  totalBill      Float       @default(0)
  discount       Float       @default(0)
  discountReason String?
  paidAmount     Float       @default(0)
  balance        Float       @default(0)
  status         String      @default("InProcess")
  isUrgent       Boolean     @default(false)
  externalId     String?
  createdBy      Int
  labId          Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdByUser  User        @relation(fields: [createdBy], references: [id])
  doctor         Doctor?     @relation(fields: [doctorId], references: [id])
  lab            Lab         @relation(fields: [labId], references: [id])
  patient        Patient     @relation(fields: [patientId], references: [id])
  orders         OrderItem[]
  payments       Payment[]
}

model OrderItem {
  id           Int       @id @default(autoincrement())
  billId       Int
  orderName    String
  orderDate    DateTime  @default(now())
  amount       Float
  resultStatus String    @default("Pending")
  resultData   String?
  resultMethod String?
  resultDoctor String?
  resultNotes  String?
  resultAdvice String?
  signatureId  String?
  verifiedBy   String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  bill         Bill      @relation(fields: [billId], references: [id])
}

model Payment {
  id         Int      @id @default(autoincrement())
  billId     Int
  amount     Float
  method     String   @default("Cash")
  reference  String?
  userId     Int
  paidAt     DateTime @default(now())
  bill       Bill     @relation(fields: [billId], references: [id])
  receivedBy User     @relation("ReceivedBy", fields: [userId], references: [id])
}

model TestMaster {
  id                    Int                   @id @default(autoincrement())
  testName              String                @unique
  hasComponents         Boolean               @default(false)
  testCode              String?
  displayOrderName      String?
  category              String                @default("General")
  price                 Float
  department            String?
  processTime           String?
  machineName           String?
  sampleType            String?
  method                String?
  resultNotes           String?
  advice                String?
  workSheet             String?
  purpose               String?
  orderType             String                @default("Internal")
  ipBillingCategoryType String?
  recurring             Boolean               @default(false)
  serviceDoctorRequired Boolean               @default(false)
  resultTemplate        String?
  uiType                String                @default("richtext")
  status                String                @default("Active")
  labId                 Int
  orderTemplates        OrderDetailTemplate[]
  orderFont             OrderFont?
  components            TestComponent[]
  lab                   Lab                   @relation(fields: [labId], references: [id])
  serviceGroups         ServiceGroup[]        @relation("ServiceGroupTests")
}

model ServiceGroup {
  id        Int          @id @default(autoincrement())
  groupName String
  amount    Float
  status    String       @default("Active")
  labId     Int
  createdAt DateTime     @default(now())
  lab       Lab          @relation(fields: [labId], references: [id])
  tests     TestMaster[] @relation("ServiceGroupTests")
}

model TestComponent {
  id            Int                  @id @default(autoincrement())
  testId        Int
  componentName String
  unit          String?
  normalRange   String?
  minMale       Float?
  maxMale       Float?
  minFemale     Float?
  maxFemale     Float?
  method        String?
  sortOrder     Int                  @default(0)
  fieldType     String               @default("number")
  options       String?
  calculations  String?
  defaultValue  String?
  fromRange     String?
  machineCode   String?
  specimenCode  String?
  status        String               @default("Active")
  subHeading    String?
  toRange       String?
  templateId    Int?
  template      OrderDetailTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  test          TestMaster           @relation(fields: [testId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  category    String?
  expenseDate DateTime @default(now())
  createdBy   Int
  labId       Int
  createdAt   DateTime @default(now())
  lab         Lab      @relation(fields: [labId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int?
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Source {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model SampleType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model OrderType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model IPBillingCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model DoctorSignature {
  id        String   @id
  label     String
  name      String
  title     String
  signText  String?
  imageData String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model OrderFont {
  id                  Int        @id @default(autoincrement())
  testId              Int        @unique
  fontFamily          String?
  patientDetailsFont  String?
  departmentNameFont  String?
  orderNameFont       String?
  resultHeadingFont   String?
  subHeadingFont      String?
  componentNameFont   String?
  methodFont          String?
  resultNotesFont     String?
  leftSignatureFont   String?
  rightSignatureFont  String?
  spaceBeforeLineFont String?
  spaceAfterLineFont  String?
  test                TestMaster @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model OrderDetailTemplate {
  id           Int             @id @default(autoincrement())
  testId       Int
  templateName String
  status       String          @default("Active")
  fromAge      Int?
  toAge        Int?
  fromAgeDays  Int?
  toAgeDays    Int?
  gender       String?         @default("Both")
  createdAt    DateTime        @default(now())
  test         TestMaster      @relation(fields: [testId], references: [id], onDelete: Cascade)
  components   TestComponent[]
}
